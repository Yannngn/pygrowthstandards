{
  "branches": [
    {
      "name": "main",
      "prerelease": false
    },
    {
      "name": "dev",
      "prerelease": true,
      "channel": "next"
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "angular"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "python -c \"import re; p='pyproject.toml'; t=open(p).read(); open(p,'w').write(re.sub(r'version = \\\"[^\\\"]*\\\"', 'version = \\\"${nextRelease.version}\\\"', t, count=1))\""
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "pyproject.toml"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": "🎉 This ${issue.pull_request ? 'PR is included in version `${nextRelease.version}`' : 'issue has been resolved in version `${nextRelease.version}`'}. The release is available on [GitHub release](${releases})",
        "failComment": false,
        "failTitle": false,
        "labels": false,
        "releasedLabels": false
      }
    ]
  ]
}